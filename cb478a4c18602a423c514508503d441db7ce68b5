      "writtenOn": "2016-09-13T00:33:11Z",
      "side": 1,
      "message": "Should this be in connectivity manager at all? This is internal to network selector and is probably best kept there.",
      "range": {
        "startLine": 122,
        "startChar": 1,
        "endLine": 124,
        "endChar": 67
      },
      "revId": "cb478a4c18602a423c514508503d441db7ce68b5",
