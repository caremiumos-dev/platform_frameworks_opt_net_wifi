      "writtenOn": "2016-12-01T17:11:36Z",
      "side": 1,
      "message": "How does config.meteredHint change? Will the settings UI write it into the config store directly? If so, then it can race with the WifiStateMachine thread and we cannot guarantee that mWifiInfo.getMeteredHint() will be correct at any time.",
      "parentUuid": "cd47938e_e4b290c5",
      "range": {
        "startLine": 5305,
        "startChar": 23,
        "endLine": 5305,
        "endChar": 34
      },
      "revId": "b9f326b3ef1be3bafae2f5cbb89a7831cccc24db",
