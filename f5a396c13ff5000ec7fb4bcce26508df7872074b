    {
      "key": {
        "uuid": "bd74b782_f8f9ec60",
        "filename": "service/java/com/android/server/wifi/WifiConnectivityManager.java",
        "patchSetId": 14
      },
      "lineNbr": 1127,
      "author": {
        "id": 1081395
      },
      "writtenOn": "2017-03-18T06:57:25Z",
      "side": 1,
      "message": "I am concerned with the trimming of the blacklist.  If you are on a particular ssid and you trim off the relevant bssids for that network, you will end up with unexpected behavior.  Do we have any protections against this?",
      "range": {
        "startLine": 1127,
        "startChar": 17,
        "endLine": 1127,
        "endChar": 45
      },
      "revId": "f5a396c13ff5000ec7fb4bcce26508df7872074b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
    {
      "key": {
