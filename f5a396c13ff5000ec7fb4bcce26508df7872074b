        "id": 1081395
      },
      "writtenOn": "2017-03-18T06:57:25Z",
      "side": 1,
      "message": "since this will eventually(?) get a whitelist to also update, would a more general name be more appropriate?",
      "range": {
        "startLine": 1127,
        "startChar": 17,
        "endLine": 1127,
        "endChar": 45
      },
      "revId": "f5a396c13ff5000ec7fb4bcce26508df7872074b",
