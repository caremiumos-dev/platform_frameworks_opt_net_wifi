    {
      "key": {
        "uuid": "6dc5e7af_372c8b50",
        "filename": "service/java/com/android/server/wifi/WifiConnectivityManager.java",
        "patchSetId": 4
      },
      "lineNbr": 1042,
      "author": {
        "id": 1081395
      },
      "writtenOn": "2017-03-03T05:53:26Z",
      "side": 1,
      "message": "in the case where the bssid is already blacklisted:\n\nyou could end up in this method where it was blacklisted, but the elapsed time is too old and it should have been cleared.  In this case you might want to check the time to see if it should have been cleared and then update the count.  or you might consider updating the time.  depends on how stale the times could possibly get.\n\nThere are tradeoffs that I can see for both sides, but my main concern would be what happens with timing depending on when a trackBssid call comes in vs a scan result.  It would be good to make sure we do the right thing and don\u0027t just lose data because of a stale timestamp.\n\nWe can chat about this if you want.  I am not sure I am clear on my concern.",
      "range": {
        "startLine": 1042,
        "startChar": 16,
        "endLine": 1042,
        "endChar": 17
      },
      "revId": "af1ee09663c9a19ead56c08b84bfa9257cf80d40",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": false
    },
