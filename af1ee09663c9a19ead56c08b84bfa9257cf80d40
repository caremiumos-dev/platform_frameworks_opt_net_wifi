        "id": 1081395
      },
      "writtenOn": "2017-03-03T05:53:26Z",
      "side": 1,
      "message": "if we can get here when a bssid is already blacklisted, it seems that updating the timestamp would be a good idea.  This way we have a more accurate time to refresh since we have a newer reported failure for the bssid.",
      "parentUuid": "e962659a_6dd36235",
      "range": {
        "startLine": 1034,
        "startChar": 16,
        "endLine": 1034,
        "endChar": 40
      },
