    {
      "key": {
        "uuid": "91e396bb_6f7afc66",
        "filename": "service/java/com/android/server/wifi/WifiConnectivityManager.java",
        "patchSetId": 4
      },
      "lineNbr": 1026,
      "author": {
        "id": 1081395
      },
      "writtenOn": "2017-03-03T05:53:26Z",
      "side": 1,
      "message": "Since it doesn\u0027t really make sense to have a null bssid here, why not just do a check at the top and return immediately?  This gives us two benefits:\n1. we can avoid the inconsistency with enable vs disable\n2. avoid the extra layer of indentation from the if (so the code is easier to read)",
      "parentUuid": "93368744_d4bd1c45",
      "range": {
        "startLine": 1026,
        "startChar": 12,
        "endLine": 1026,
        "endChar": 31
      },
