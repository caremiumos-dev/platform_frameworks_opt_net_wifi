        "id": 1081395
      },
      "writtenOn": "2017-03-18T07:39:24Z",
      "side": 1,
      "message": "what if an association rejection comes in right around the same time as a scheduled scan?  do we assume scanning service will bucket them for us?",
      "parentUuid": "c202635c_96f5e5ce",
      "range": {
        "startLine": 1070,
        "startChar": 0,
        "endLine": 1070,
        "endChar": 52
      },
      "revId": "3a1a8f70256fb4eb9abe38cc575eef512edd4dfc",
