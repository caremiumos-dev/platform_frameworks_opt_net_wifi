      "writtenOn": "2017-02-02T07:48:28Z",
      "side": 1,
      "message": "why does this have to be a separate message?  it seems like you would just put it in the regular call.",
      "range": {
        "startLine": 5193,
        "startChar": 21,
        "endLine": 5193,
        "endChar": 52
