      },
      "lineNbr": 125,
      "author": {
        "id": 1081395
      },
      "writtenOn": "2016-11-07T19:37:22Z",
      "side": 1,
      "message": "I kept this here for the case where the system starts up with wifi disabled.  This way, if it is never enabled, we do not create the state machine at all.",
      "parentUuid": "810004b4_92beecb4",
      "revId": "a7ef211f45e23c332a80c21fe87dec70a99cceea",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
