      },
      "writtenOn": "2016-11-01T17:26:59Z",
      "side": 1,
      "message": "Don\u0027t need this, you always deliver the intended mode afterward.",
      "range": {
        "startLine": 156,
        "startChar": 25,
        "endLine": 156,
        "endChar": 40
      },
      "revId": "a7ef211f45e23c332a80c21fe87dec70a99cceea",
