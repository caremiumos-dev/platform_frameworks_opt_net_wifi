      },
      "writtenOn": "2016-10-26T17:44:25Z",
      "side": 1,
      "message": "Not sure we need this local variable. Can we just chain the calls together?\n\n  WifiInjector.getInstance().makeLog(mTag)",
      "range": {
        "startLine": 54,
        "startChar": 12,
        "endLine": 54,
        "endChar": 40
      },
      "revId": "57bdc6284e142a72e14709f0911b699f5e97d95c",
