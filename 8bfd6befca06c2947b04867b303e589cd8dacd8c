      "writtenOn": "2016-09-13T00:38:41Z",
      "side": 1,
      "message": "Should this get cleared out when wifi is toggled? It might not be today, but probably makes sense",
      "revId": "8bfd6befca06c2947b04867b303e589cd8dacd8c",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
