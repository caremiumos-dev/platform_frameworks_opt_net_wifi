    {
      "key": {
        "uuid": "d6a3021d_a29f88a0",
        "filename": "service/java/com/android/server/wifi/WifiConnectivityManager.java",
        "patchSetId": 11
      },
      "lineNbr": 637,
      "author": {
        "id": 1086611
      },
      "writtenOn": "2017-02-12T06:52:26Z",
      "side": 1,
      "message": "I think it gives a cleaner boundary when framework is only responsible for SSID level network selection and let firmware be responsible for BSSID level network selection, no matter it\u0027s the very first time connection or roaming later on.\n\nGiven we have to deal wth different vendors, we don\u0027t want to assume firmware\u0027s behavior. If a firmware doesn\u0027t behave correctly, it\u0027s better to let it fail early and fail consistently.",
      "parentUuid": "d198cfa3_7d187df9",
      "range": {
        "startLine": 637,
        "startChar": 16,
        "endLine": 637,
        "endChar": 68
      },
      "revId": "c7683ab80db0970e6422d9405c99b5f67d951fc8",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
